{
  "name": "pi-edit-session-in-place",
  "version": "0.3.0",
  "description": "pi extension that lets you re-edit or delete an earlier user message in the current session branch",
  "author": "Mitch Fultz (https://github.com/fitchmultz)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "extension",
    "session",
    "history",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-edit-session-in-place.git"
  },
  "bugs": {
    "url": "https://github.com/fitchmultz/pi-edit-session-in-place/issues"
  },
  "homepage": "https://github.com/fitchmultz/pi-edit-session-in-place#readme",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc",
    "check": "npm test && npm run typecheck && npm pack --dry-run",
    "check:compat": "npm run check",
    "prepublishOnly": "npm run check"
  },
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "24.19.0",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@12.1.0"
}
